# Persistent tuning for FormationAI. Edit and restart uvicorn to apply.
# Any of these can still be overridden by a shell env var.

# Detection & speed
# iter 4: bumped from 960 → 1280 for better detection of small/distant dancers
FORMATIONAI_YOLO_IMAGE_SIZE=1280
# iter 1: lowered from 0.35 → 0.20 to catch partially-occluded/distant dancers.
# Baseline (iter 0) only had 6 dancers visible in 19.9% of frames.
FORMATIONAI_YOLO_CONFIDENCE_THRESHOLD=0.20
FORMATIONAI_GENERATE_DEBUG_VIDEO=true
# bytetrack.yaml = motion-only, fast (~3 fps on CPU).
# botsort_reid.yaml = motion + appearance ReID, slow (~1 fps) but better at crossings.
# We use ByteTrack for speed and apply appearance corrections in post-processing instead.
# iter 2: switching to BoT-SORT+ReID for per-frame appearance binding.
# Aims to fix iter 1's identity fragmentation (10 IDs for 6 dancers).
# Slower (~1 fps vs 4 fps) but appearance ReID re-binds intermittent detections.
FORMATIONAI_TRACKER_CONFIG=botsort_reid.yaml

# Color-histogram appearance settings — extracts outfit colors per dancer for
# post-processing merges and appearance-aware ID continuity recovery.
FORMATIONAI_APPEARANCE_MERGE_THRESHOLD=0.92
# Sample histograms every N frames (1=every frame, 5=every 5th).
# Higher = faster processing, slightly noisier outfit fingerprint.
FORMATIONAI_APPEARANCE_SAMPLE_EVERY=3

# Formation segmentation — short K-pop formations
# How still the dancers must be to count as holding a formation: average speed
# relative to the group (a formation drifting as a unit counts only partly),
# in formation sizes per second. Raised automatically above each clip's own
# jitter. Measured on the top-down stage, so a back-row walk counts as much as
# a front-row one. (Replaces the old FORMATIONAI_FORMATION_MOVEMENT_THRESHOLD_PX.)
FORMATIONAI_FORMATION_MOVEMENT_THRESHOLD=0.25
FORMATIONAI_FORMATION_MIN_DURATION_SEC=0.2
FORMATIONAI_FORMATION_SPLIT_THRESHOLD=0.12
FORMATIONAI_INTERPOLATION_MAX_GAP_FRAMES=150

# Visual cleanup
FORMATIONAI_FORMATION_SNAP_GRID_STEP=0
FORMATIONAI_FORMATION_TEMPLATE_SNAP_THRESHOLD=0.08

# ID continuity recovery — re-link dancers who disappeared and came back with a new ID.
# With appearance enabled, position limit auto-relaxes to 3x when outfit matches well.
FORMATIONAI_ID_CONTINUITY_MAX_GAP_FRAMES=240
FORMATIONAI_ID_CONTINUITY_MAX_DISTANCE=0.18

# Auto-swap detection — looser thresholds catch more crossings
FORMATIONAI_AUTO_SWAP_JUMP_THRESHOLD=0.04
FORMATIONAI_AUTO_SWAP_ADVANTAGE_RATIO=2.0

# Gradual-swap detection (for slow crossings that don't show as one-frame jumps)
FORMATIONAI_GRADUAL_SWAP_PROXIMITY=0.15
FORMATIONAI_GRADUAL_SWAP_ADVANTAGE=1.10

# LocateAnything detector (NVIDIA Eagle/Embodied) — when enabled, requires a
# dancer roster on upload and runs per-frame against the configured URL.
# Leave disabled until you have an inference endpoint up on the DGX or hosted.
FORMATIONAI_LOCATEANYTHING_BACKEND=disabled
# FORMATIONAI_LOCATEANYTHING_URL=http://<dgx-host>:9100/locate
# FORMATIONAI_LOCATEANYTHING_TIMEOUT_SEC=60

# SAM2 click-to-track (Meta Segment Anything Model 2) — when enabled, upload
# pauses for the user to click each dancer on a key frame, then SAM2 propagates
# masks across the whole video in one call. Recommended path for K-pop clips.
FORMATIONAI_SAM2_BACKEND=disabled
# FORMATIONAI_SAM2_URL=http://localhost:9200/track
# FORMATIONAI_SAM2_TIMEOUT_SEC=600

# CoTracker3 click-to-track (Meta, runs in-process on CPU)
# When enabled, upload pauses for the user to click each dancer on a key frame,
# then CoTracker3 follows the click points across the whole video.
# Slower than YOLO (~2 fps) but identity is solved by construction.
# Note: CoTracker3 internally resamples every frame to 512x384, so raising
# RESIZE_WIDTH above ~512 does not improve tracking; it only costs decode time.
FORMATIONAI_COTRACKER_BACKEND=local
FORMATIONAI_COTRACKER_RESIZE_WIDTH=960
# Track 2 extra points per dancer (chest + hips, from the YOLO box under the
# click) and use the median, so one point sliding onto a neighbour is outvoted.
# Set false for faster processing (fewer tracked points).
FORMATIONAI_COTRACKER_AUTO_POINTS=true

# Identity correction: run the person detector on every frame and keep each
# dancer on the right person (motion + outfit/hair appearance + tracked-point
# votes). Fixes dots swapping onto another dancer after occlusions/clumps.
# IDENTITY_DETECT_EVERY=2 halves the extra detector time.
FORMATIONAI_IDENTITY_TRACKING=true
FORMATIONAI_IDENTITY_DETECT_EVERY=1
# Appearance cue: OSNet person re-identification (weights ~3 MB, downloaded
# once). false = colour histograms (weaker when outfits are similar).
FORMATIONAI_IDENTITY_REID=true
